{
	"bsonType": "object",
	"required": ["f_room_code", "f_player_uid"],
	"properties": {
		"f_room_code": { "bsonType": "string" },
		"f_player_uid": { "bsonType": "string", "description": "玩家 f_uid" },
		"f_nick_name": { "bsonType": "string", "description": "加入房间时的昵称快照（展示用）" },
		"f_joined_at": { "bsonType": "timestamp" },
		"f_role_id": { "bsonType": "int", "description": "选择的角色ID(1-10)" },
		"f_role_name": { "bsonType": "string", "description": "角色名称" },
		"f_role_selected_at": { "bsonType": "timestamp", "description": "选择角色的时间" },
		"f_random_count": { "bsonType": "int", "description": "已使用随机次数", "default": 0 }
	}
}
