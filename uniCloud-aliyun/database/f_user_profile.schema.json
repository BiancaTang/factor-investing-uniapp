{
	"bsonType": "object",
	"required": ["f_uid", "f_nick_name", "f_avatar_url"],
	"properties": {
		"_id": { "description": "系统自动生成" },
		"f_uid": { "bsonType": "string", "description": "内部用户标识，客户端存储用于云接口，不向用户展示" },
		"f_avatar_url": { "bsonType": "string", "description": "头像地址" },
		"f_nick_name": { "bsonType": "string", "description": "昵称（登录匹配键）" },
		"f_phone": { "bsonType": "string", "description": "号码（可选，历史字段）" },
		"f_role": {
			"bsonType": "string",
			"description": "player=玩家(默认)；admin=管理员，仅在控制台手动修改"
		},
		"f_created_at": { "bsonType": "timestamp", "description": "创建时间" },
		"f_updated_at": { "bsonType": "timestamp", "description": "更新时间" }
	}
}
